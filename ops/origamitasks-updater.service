[Unit]
Description=OrigamiTasks trusted Git update worker
Wants=network-online.target docker.service
After=network-online.target docker.service
[Service]
Type=simple
WorkingDirectory=/opt/OrigamiTasks
ExecStart=/usr/bin/python3 /opt/OrigamiTasks/ops/update-worker.py --root /opt/OrigamiTasks
Restart=always
RestartSec=5
# Needs host permission to run docker compose (privileged service).
# Recommended: dedicated service account with docker group permissions, never inside web container.
[Install]
WantedBy=multi-user.target
