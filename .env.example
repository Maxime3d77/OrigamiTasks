# Generate real secrets using bash ops/bootstrap.sh (never commit .env).
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
VAULT_KEY=REPLACE_WITH_FERNET_KEY
COOKIE_SECURE=true
# Executing local scripts shares the application security boundary. Off by default.
ALLOW_LOCAL_EXECUTION=false
ORIGAMI_PORT=8080
ORIGAMI_EXECUTOR_WORKERS=2
MAX_STEP_SECONDS=1800
SESSION_HOURS=12
GIT_BRANCH=main
GIT_ALLOWED_ORIGIN=
# LDAPS example. LDAP is disabled unless LDAP_URI is set.
LDAP_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_USER_ATTRIBUTE=sAMAccountName
LDAP_ADMIN_GROUP=origamitasks-admins
LDAP_OPERATOR_GROUP=origamitasks-operators
LDAP_VIEWER_GROUP=origamitasks-viewers
LDAP_NESTED_GROUPS=false
LDAP_STARTTLS=false
LDAP_CA_CERT=

# Connecteurs API - autoriser seulement vos hôtes HTTPS de confiance (ex: matrix.exemple.fr,pve.example.fr:8006)
MATRIX_ALLOWED_HOSTS=
PROXMOX_ALLOWED_HOSTS=
# Certificat CA custom en PEM monté dans le conteneur, si Proxmox utilise une CA interne
PROXMOX_CA_CERT=
# Opérations VM (start/shutdown/reboot) désactivées en production jusqu’à validation
ALLOW_PROXMOX_ACTIONS=false
